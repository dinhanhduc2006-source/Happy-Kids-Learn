<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Chân đế gỗ mật ong 2.5D -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#DFA74A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Mặt bục chữ cái kem vàng nắng -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FFEAB8"
                android:startColor="#FFFDF5" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2.5dp"
                android:color="#FFC857" />
        </shape>
    </item>
</layer-list>

