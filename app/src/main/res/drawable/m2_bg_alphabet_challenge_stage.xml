<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Chân đế tím hoa 2.5D -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#6F54C9" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Bề mặt sân khấu thử thách -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F3ECFF"
                android:startColor="#FFFDF9" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2.5dp"
                android:color="#A98BFA" />
        </shape>
    </item>
</layer-list>

