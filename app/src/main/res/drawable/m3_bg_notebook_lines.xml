<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền trắng -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_board_white" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="@color/m3_board_border"/>
        </shape>
    </item>

    <!-- Các dòng kẻ ngang vở ô ly -->
    <item android:top="60dp">
        <shape android:shape="line">
            <stroke android:width="1dp" android:color="#E0E0E0" android:dashWidth="4dp" android:dashGap="4dp" />
        </shape>
    </item>
    <item android:top="140dp">
        <shape android:shape="line">
            <stroke android:width="1dp" android:color="#E0E0E0" android:dashWidth="4dp" android:dashGap="4dp" />
        </shape>
    </item>
    <item android:top="220dp">
        <shape android:shape="line">
            <stroke android:width="1dp" android:color="#E0E0E0" android:dashWidth="4dp" android:dashGap="4dp" />
        </shape>
    </item>
    <item android:top="300dp">
        <shape android:shape="line">
            <stroke android:width="1dp" android:color="#E0E0E0" android:dashWidth="4dp" android:dashGap="4dp" />
        </shape>
    </item>
</layer-list>