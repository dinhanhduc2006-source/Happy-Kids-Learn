<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hiệu ứng khối chữ phát sáng rực rỡ khi bé ghép đúng từ -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#288E53" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#BAFAD2"
                android:startColor="#FFFDF0" />
            <corners android:radius="18dp" />
            <stroke
                android:width="3dp"
                android:color="#FFC857" />
        </shape>
    </item>
</layer-list>

