<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="14dp" />
            <solid android:color="#FDF6E7" />
            <stroke
                android:width="1dp"
                android:color="#DEC8A8" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#E5D3B5" />
        </shape>
    </item>
</layer-list>

