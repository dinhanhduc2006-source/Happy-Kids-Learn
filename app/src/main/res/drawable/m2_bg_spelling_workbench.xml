<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cạnh bàn gỗ chế tạo 3D -->
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#B8732A" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Mặt bàn gỗ ấm áp -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F7E0B8"
                android:startColor="#FFF5E0" />
            <corners android:radius="22dp" />
            <stroke
                android:width="2.5dp"
                android:color="#DDA059" />
        </shape>
    </item>
    <!-- Đường chỉ khâu thảm chế tạo -->
    <item
        android:bottom="10dp"
        android:left="6dp"
        android:right="6dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.2dp"
                android:color="#D6AE74"
                android:dashGap="4dp"
                android:dashWidth="6dp" />
        </shape>
    </item>
</layer-list>

