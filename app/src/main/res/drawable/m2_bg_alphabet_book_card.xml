<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp bìa sách cứng bên dưới tạo độ nổi 3D của trang sách mở -->
    <item android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#D68936" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Lớp mép giấy xếp chồng ở đáy sách -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F3E2C3" />
            <corners android:radius="26dp" />
            <stroke
                android:width="2dp"
                android:color="#E5C58E" />
        </shape>
    </item>
    <!-- Mặt trang sách giấy kem ấm chính -->
    <item android:bottom="8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FFF6E3"
                android:startColor="#FFFDF8" />
            <corners android:radius="26dp" />
            <stroke
                android:width="3dp"
                android:color="#F5B041" />
        </shape>
    </item>
    <!-- Gáy sách trang trí bên trái -->
    <item
        android:bottom="8dp"
        android:left="0dp"
        android:width="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FFE0A3"
                android:startColor="#F5B041" />
            <corners
                android:bottomLeftRadius="26dp"
                android:topLeftRadius="26dp" />
        </shape>
    </item>
    <!-- Đường chỉ khâu vàng ấm quanh trang sách -->
    <item
        android:bottom="14dp"
        android:left="18dp"
        android:right="8dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#E8C98E"
                android:dashGap="4dp"
                android:dashWidth="7dp" />
        </shape>
    </item>
</layer-list>

