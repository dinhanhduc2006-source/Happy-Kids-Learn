<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gáy sách 3D có độ bóng nổi -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="4dp"
                android:topLeftRadius="18dp"
                android:topRightRadius="4dp" />
            <gradient
                android:angle="0"
                android:centerColor="#40FFFFFF"
                android:endColor="#38000000"
                android:startColor="#26000000" />
        </shape>
    </item>
    <!-- Đai vàng trang trí gáy sách trên -->
    <item
        android:gravity="top"
        android:height="7dp"
        android:top="22dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD166" />
        </shape>
    </item>
    <!-- Đai vàng trang trí gáy sách dưới -->
    <item
        android:bottom="28dp"
        android:gravity="bottom"
        android:height="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD166" />
        </shape>
    </item>
</layer-list>

