<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bóng lõm phía trên của khe bàn chế tạo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D9C39E" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Lòng khe gỗ lõm nhẹ -->
    <item
        android:bottom="1dp"
        android:left="2dp"
        android:right="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F4E8D1" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="#B89764"
                android:dashGap="4dp"
                android:dashWidth="6dp" />
        </shape>
    </item>
</layer-list>
