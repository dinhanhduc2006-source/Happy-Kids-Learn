<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m2_bg_screen"
    android:orientation="vertical">

    <!-- Header 2.5D đồng bộ phong cách Cuốn Sách Kỳ Diệu -->
    <include layout="@layout/m2_layout_game_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/m4_screen_padding">

            <!-- Thẻ hướng dẫn câu hỏi -->
            <LinearLayout style="@style/m4_style_question_card">

                <TextView
                    android:id="@+id/tv_question_title"
                    style="@style/m4_style_question_title"
                    android:text="Bé hãy đếm xem có bao nhiêu quả táo?" />

                <TextView
                    android:id="@+id/tv_count_feedback"
                    style="@style/m4_style_question_subtitle"
                    android:text="Chạm vào đồ vật để đếm: 0" />
            </LinearLayout>

            <!-- Lưới chứa đồ vật đếm căn giữa (Tối đa 5 ô/hàng) -->
            <GridLayout
                android:id="@+id/gl_objects_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:alignmentMode="alignBounds"
                android:columnCount="5"
                android:gravity="center" />

            <!-- Tiêu đề chọn đáp án -->
            <TextView
                style="@style/m4_style_question_title"
                android:layout_marginBottom="12dp"
                android:text="Chọn số lượng đúng:" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignBounds"
                android:columnCount="2">

                <Button
                    android:id="@+id/btn_option_1"
                    style="@style/m4_style_option_button"
                    android:text="3" />

                <Button
                    android:id="@+id/btn_option_2"
                    style="@style/m4_style_option_button"
                    android:text="5" />

                <Button
                    android:id="@+id/btn_option_3"
                    style="@style/m4_style_option_button"
                    android:text="7" />

                <Button
                    android:id="@+id/btn_option_4"
                    style="@style/m4_style_option_button"
                    android:text="9" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>