<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_gate_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 VÙNG PHỤ HUYNH"
        android:textColor="@color/purple_700"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_gate_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Vui lòng nhờ phụ huynh giải phép tính dưới đây để tiếp tục:"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_gate_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="Chín trừ ba bằng mấy?"
        android:textColor="@color/accent_orange"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_gate_answer"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_rounded"
        android:backgroundTint="@color/bg_light_blue"
        android:gravity="center"
        android:hint="Nhập kết quả"
        android:inputType="number"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_gate_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/star_gray"
            android:text="Hủy"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_gate_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/purple_500"
            android:text="Xác nhận"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>