<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề chiến thắng -->
    <TextView
        android:id="@+id/tv_victory_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 XUẤT SẮC! 🎉"
        android:textColor="@color/accent_orange"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- 3 Ngôi sao đánh giá -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_star1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/img_star2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_star_filled" />

        <ImageView
            android:id="@+id/img_star3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_star_filled" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_victory_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bé đã hoàn thành xuất sắc bài học này!"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:gravity="center" />

    <!-- Nút điều hướng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_replay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/accent_yellow"
            android:text="Chơi lại"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_green"
            android:text="Tiếp tục"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>