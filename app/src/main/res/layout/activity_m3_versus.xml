<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:splitMotionEvents="true"
    android:background="@color/m3_bg_cream">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/accent_pink"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_header_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/m3_btn_clear"/>

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_header_back"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar
                android:id="@+id/pb_header_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/tv_header_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_header_sound"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/m3_btn_undo"/>
    </RelativeLayout>

    <!-- VERSUS BATTLE AREA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:splitMotionEvents="true">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <!-- PLAYER 1 AREA (Top, Rotated 180) -->
        <RelativeLayout
            android:id="@+id/layout_m3_p1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:rotation="180"
            android:background="@drawable/m3_bg_versus_p1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/tv_m3_p1_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_lbl_player_1"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main" />

                <TextView
                    android:id="@+id/tv_m3_p1_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 25"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main"
                    android:layout_marginTop="8dp"/>

                <ProgressBar
                    android:id="@+id/pb_m3_p1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="200dp"
                    android:layout_height="20dp"
                    android:max="25"
                    android:progress="0"
                    android:progressTint="@color/m3_btn_orange"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btn_m3_p1_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_btn_versus_tap"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/m3_btn_pill_orange"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="24dp"
                    android:clickable="false"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- PLAYER 2 AREA (Bottom, Normal orientation) -->
        <RelativeLayout
            android:id="@+id/layout_m3_p2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:background="@drawable/m3_bg_versus_p2"
            app:layout_constraintTop_toBottomOf="@id/guideline_center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/tv_m3_p2_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_lbl_player_2"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main" />

                <TextView
                    android:id="@+id/tv_m3_p2_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 25"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_text_main"
                    android:layout_marginTop="8dp"/>

                <ProgressBar
                    android:id="@+id/pb_m3_p2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="200dp"
                    android:layout_height="20dp"
                    android:max="25"
                    android:progress="0"
                    android:progressTint="@color/m3_btn_green"
                    android:layout_marginTop="16dp" />

                <Button
                    android:id="@+id/btn_m3_p2_tap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m3_btn_versus_tap"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/m3_btn_pill_green"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="32dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="24dp"
                    android:clickable="false"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- CENTER BADGE (VS) & START BUTTON -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/guideline_center"
            app:layout_constraintBottom_toBottomOf="@id/guideline_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="8dp">

            <TextView
                android:id="@+id/tv_m3_vs_badge"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/m3_bg_versus_vs"
                android:text="@string/m3_lbl_vs"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/m3_btn_orange"
                android:gravity="center"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/btn_m3_start_versus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m3_lbl_start_versus"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:backgroundTint="@color/m3_btn_green"
                android:textColor="#FFFFFF"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tv_m3_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/m3_color_red"
                android:layout_gravity="center"
                android:visibility="gone"
                android:background="@drawable/m3_bg_board_white"
                android:paddingHorizontal="32dp"
                android:paddingVertical="8dp"/>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>