<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/m2_spelling_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m2_bg_screen"
    android:orientation="vertical"
    tools:context=".member2.spelling.SpellingActivity">

    <!-- Header 2.5D đồng bộ phong cách Cuốn Sách Kỳ Diệu -->
    <include layout="@layout/m2_layout_game_header" />

    <!-- Khu vực Linh vật Sao Bông hướng dẫn tại Xưởng Chế Tạo Từ Ngữ -->
    <LinearLayout
        android:id="@+id/ll_m2_spelling_mascot_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/m2_bg_alphabet_garden_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_m2_spelling_mascot"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/m2_cd_mascot"
            android:scaleType="fitCenter"
            android:src="@drawable/m2_mascot_saobong_welcome" />

        <TextView
            android:id="@+id/tv_m2_spelling_mascot_speech"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:text="@string/m2_spelling_instruction"
            android:textColor="@color/m2_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thanh chọn nhanh 16 bản vẽ từ ngữ -->
    <HorizontalScrollView
        android:id="@+id/hsv_m2_spelling_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_m2_spelling_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <!-- Trang sách Xưởng Chế Tạo 2.5D -->
            <LinearLayout
                android:id="@+id/card_m2_spelling_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/m2_bg_alphabet_book_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp">

                <!-- Hàng 1: Số thứ tự bài x/16 và Huy hiệu trạng thái -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_m2_spelling_index"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/m2_bg_star_pill"
                        android:fontFamily="sans-serif-black"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Bài 1/16"
                        android:textColor="@color/m2_text_book_title"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_m2_spelling_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/m2_bg_badge_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/m2_spelling_status_new"
                        android:textColor="@color/m2_badge_ready_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hàng 2: Bản vẽ Minh họa từ cần ghép + Nút Nghe từ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/m2_bg_alphabet_illust_frame"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iv_m2_spelling_illust"
                        android:layout_width="86dp"
                        android:layout_height="86dp"
                        android:contentDescription="@string/m2_cd_alphabet_illustration_format"
                        android:scaleType="fitCenter"
                        android:src="@drawable/m2_illust_alpha_object" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_m2_spelling_context"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Ba của bé"
                            android:textColor="@color/m2_text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_m2_spelling_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Từ cần ghép có 2 âm/chữ"
                            android:textColor="@color/m2_text_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_m2_spelling_listen"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:backgroundTint="@color/m2_brand_teal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/m2_spelling_btn_listen"
                            android:textAllCaps="false"
                            android:textColor="@color/m2_text_on_accent"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hàng 3: Bàn Chế Tạo Từ Ngữ bằng gỗ 2.5D (Drop Targets) -->
                <LinearLayout
                    android:id="@+id/ll_m2_spelling_workbench"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/m2_bg_spelling_workbench"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/m2_spelling_slots_label"
                        android:textColor="@color/m2_text_book_title"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/ll_m2_spelling_slots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:minHeight="72dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Thông báo phản hồi đúng/sai -->
                <TextView
                    android:id="@+id/tv_m2_spelling_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/m2_bg_badge_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="@string/m2_spelling_feedback_prompt"
                    android:textColor="@color/m2_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Hàng 4: Khay Khối Chữ Gỗ Đồ Chơi 2.5D -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/m2_bg_spelling_tray"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="@string/m2_spelling_pool_label"
                        android:textColor="@color/m2_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fillViewport="true"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ll_m2_spelling_pool"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minHeight="70dp"
                            android:orientation="horizontal"
                            android:padding="2dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Hàng nút công cụ xưởng: Gợi ý 1 bước / Xóa lại / Kiểm tra -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_m2_spelling_hint"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1.15"
                        android:backgroundTint="@color/m2_brand_gold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="6dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="0dp"
                        android:singleLine="true"
                        android:text="@string/m2_spelling_btn_hint"
                        android:textAllCaps="false"
                        android:textColor="@color/m2_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_m2_spelling_clear"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="0.95"
                        android:backgroundTint="@color/m2_chip_stroke"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="6dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="0dp"
                        android:singleLine="true"
                        android:text="@string/m2_spelling_btn_clear"
                        android:textAllCaps="false"
                        android:textColor="@color/m2_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_m2_spelling_check"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1.1"
                        android:backgroundTint="@color/m2_accent_green"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="6dp"
                        android:paddingTop="0dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="0dp"
                        android:singleLine="true"
                        android:text="@string/m2_spelling_btn_check"
                        android:textAllCaps="false"
                        android:textColor="@color/m2_text_on_accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Thanh điều hướng Bài trước / Bài tiếp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btn_m2_spelling_prev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/m2_chip_stroke"
            android:text="@string/m2_spelling_btn_prev"
            android:textAllCaps="false"
            android:textColor="@color/m2_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_m2_spelling_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/m2_accent_orange"
            android:text="@string/m2_spelling_btn_next"
            android:textAllCaps="false"
            android:textColor="@color/m2_text_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
