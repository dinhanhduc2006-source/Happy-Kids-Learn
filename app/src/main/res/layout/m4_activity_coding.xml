<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m2_bg_screen"
    android:orientation="vertical">

    <!-- Header 2.5D đồng bộ phong cách Cuốn Sách Kỳ Diệu -->
    <include layout="@layout/m2_layout_game_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/m4_screen_padding">

            <!-- Thẻ hướng dẫn nhiệm vụ lập trình -->
            <LinearLayout style="@style/m4_style_question_card">

                <TextView
                    android:id="@+id/tv_question_title"
                    style="@style/m4_style_question_title"
                    android:text="🤖 Lập trình khối lệnh đưa Robot về Cờ Đích!" />
            </LinearLayout>

            <!-- Khung Bản đồ Ma trận Lưới Robot căn giữa -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/m2_bg_alphabet_challenge_stage"
                android:padding="12dp">

                <GridLayout
                    android:id="@+id/gl_map_matrix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignBounds"
                    android:columnCount="4"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Hàng đợi lệnh đã chọn -->
            <TextView
                style="@style/m4_style_question_subtitle"
                android:layout_marginBottom="4dp"
                android:text="Hàng đợi khối lệnh:" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/m4_bg_life_shelf"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/ll_command_queue"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Hàng 1: 4 nút bấm Mũi tên hướng (Dùng Icon Vector chuẩn, cùng cỡ 24dp tuyệt đối) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_cmd_up"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_purple"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="Tiến"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/m4_ic_coding_arrow_up"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white" />

                <Button
                    android:id="@+id/btn_cmd_down"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_purple"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="Lùi"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/m4_ic_coding_arrow_down"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white" />

                <Button
                    android:id="@+id/btn_cmd_left"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_purple"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="Trái"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/m4_ic_coding_arrow_left"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white" />

                <Button
                    android:id="@+id/btn_cmd_right"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_purple"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="Phải"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/m4_ic_coding_arrow_right"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- Hàng 2: Nút điều khiển Xóa lệnh & Chạy Lập Trình -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_clear_commands"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_orange"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="🧹 Xóa lệnh"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_run_coding"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/m2_accent_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="🚀 CHẠY LỆNH"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>