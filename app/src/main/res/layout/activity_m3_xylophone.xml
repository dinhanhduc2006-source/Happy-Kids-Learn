<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E6F2FF">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/accent_yellow"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_header_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_header_back"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar
                android:id="@+id/pb_header_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:max="100" />
            <TextView
                android:id="@+id/tv_header_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_header_sound"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_launcher_foreground" />
    </RelativeLayout>

    <!-- XYLOPHONE KEYS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom|center_horizontal"
        android:padding="16dp">

        <!-- Đô -->
        <TextView android:id="@+id/m3_key_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_red" android:text="Đô" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- Rê -->
        <TextView android:id="@+id/m3_key_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="20dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_orange" android:text="Rê" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- Mi -->
        <TextView android:id="@+id/m3_key_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="40dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_yellow" android:text="Mi" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- Pha -->
        <TextView android:id="@+id/m3_key_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="60dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_green" android:text="Pha" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- Sol -->
        <TextView android:id="@+id/m3_key_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="80dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_blue" android:text="Sol" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- La -->
        <TextView android:id="@+id/m3_key_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="100dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_purple" android:text="La" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <!-- Si -->
        <TextView android:id="@+id/m3_key_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="120dp" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_pink" android:text="Si" android:gravity="bottom|center_horizontal" android:paddingBottom="24dp" android:textSize="24sp" android:textStyle="bold" android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- FOOTER CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btn_m3_play_melody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nghe giai điệu mẫu"
            android:paddingHorizontal="32dp"/>
    </LinearLayout>
</LinearLayout>