<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_bg_cream">

    <!-- HEADER -->
    <include layout="@layout/m2_layout_game_header" />

    <!-- XYLOPHONE BOARD -->
    <FrameLayout
        android:id="@+id/layout_m3_xylo_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="@drawable/m3_bg_board_white">

        <!-- Wooden racks -->
        <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="60dp" android:layout_marginHorizontal="24dp" android:background="@drawable/m3_bg_wood_rack" />
        <View android:layout_width="match_parent" android:layout_height="12dp" android:layout_gravity="bottom" android:layout_marginBottom="60dp" android:layout_marginHorizontal="24dp" android:background="@drawable/m3_bg_wood_rack" />

        <!-- XYLOPHONE KEYS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="bottom|center_horizontal"
            android:padding="24dp"
            android:clipChildren="false">

            <!-- Đô -->
            <FrameLayout android:id="@+id/m3_key_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_red" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Đô" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- Rê -->
            <FrameLayout android:id="@+id/m3_key_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="20dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_orange" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Rê" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- Mi -->
            <FrameLayout android:id="@+id/m3_key_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="40dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_yellow" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Mi" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- Pha -->
            <FrameLayout android:id="@+id/m3_key_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="60dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_green" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Pha" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- Sol -->
            <FrameLayout android:id="@+id/m3_key_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="80dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_blue" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Sol" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- La -->
            <FrameLayout android:id="@+id/m3_key_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="100dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_purple" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="La" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

            <!-- Si -->
            <FrameLayout android:id="@+id/m3_key_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:layout_marginTop="120dp">
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/m3_bg_xylophone_key" android:backgroundTint="@color/m3_color_pink" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:background="@drawable/m3_rivet" />
                <View android:layout_width="12dp" android:layout_height="12dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:background="@drawable/m3_rivet" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="Si" android:gravity="bottom|center_horizontal" android:paddingBottom="40dp" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- FOOTER CONTROLS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_m3_play_melody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_btn_pill_orange"
            android:text="@string/m3_btn_play_melody"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="32dp"/>
    </LinearLayout>
</LinearLayout>