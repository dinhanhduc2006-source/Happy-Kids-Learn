<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_bg_cream">

    <!-- HEADER (Kèm thanh tiến độ & Ngôi sao học tập) -->
    <include layout="@layout/m2_layout_game_header" />

    <!-- BANNER HƯỚNG DẪN KÈM NÚT ĐỌC LOA 🔊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/m3_bg_banner_mint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_m3_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="8dp"
            android:text="✏️ Bé tô 1 nét chữ o — 🐝 Con ong"
            android:textColor="@color/m3_text_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_m3_speak"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/m3_bg_item_tile"
            android:contentDescription="Phát âm"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_lock_silent_mode_off" />
    </LinearLayout>

    <!-- HÀNG CHỌN BÀI HỌC (Horizontal Lesson Selector - CHỮ THƯỜNG) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_m3_lesson_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- KHU VỰC BẢNG VIẾT -->
    <FrameLayout
        android:id="@+id/layout_m3_board_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/m3_bg_board_white">

        <!-- Bảng vẽ dòng kẻ ô ly & chữ mẫu thường 1 nét -->
        <com.example.happykidlearn.member3.handwriting.HandwritingBoardView
            android:id="@+id/view_m3_handwriting_board"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút chuyển bài Trước / Sau nổi 2 bên -->
        <ImageButton
            android:id="@+id/btn_m3_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="@drawable/m3_bg_item_tile"
            android:contentDescription="Trước"
            android:elevation="4dp"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/btn_m3_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:background="@drawable/m3_bg_item_tile"
            android:contentDescription="Tiếp theo"
            android:elevation="4dp"
            android:src="@android:drawable/ic_media_next" />

        <!-- Banner thông báo khích lệ nổi -->
        <TextView
            android:id="@+id/tv_m3_encourage_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/m3_bg_card_amber"
            android:elevation="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="Bé hãy tô liền 1 nét cho kín chữ nhé!"
            android:textColor="@color/m3_text_main"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- THANH CHỌN MÀU SÁP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/m3_bg_board_white"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <View
            android:id="@+id/color_red"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_red" />

        <View
            android:id="@+id/color_orange"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_orange" />

        <View
            android:id="@+id/color_green"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_green" />

        <View
            android:id="@+id/color_blue"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_blue" />

        <View
            android:id="@+id/color_purple"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_purple" />

        <View
            android:id="@+id/color_black"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="3dp"
            android:background="@color/m3_color_black" />
    </LinearLayout>

    <!-- ĐÁY MÀN HÌNH (Viết lại & Hoàn thành) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <Button
            android:id="@+id/btn_m3_clear"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/m3_btn_pill_orange"
            android:text="🔄 Viết lại"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_m3_finish_letter"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/m3_btn_pill_green"
            android:text="✅ Hoàn thành"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>