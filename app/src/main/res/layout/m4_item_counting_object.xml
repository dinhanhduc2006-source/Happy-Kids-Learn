<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_counting_item_root"
    android:layout_width="72dp"
    android:layout_height="72dp"
    android:layout_margin="6dp"
    android:background="@drawable/m4_bg_counting_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Hình ảnh đồ vật đếm (Phóng to ~75% chiếm ô trắng) -->
    <ImageView
        android:id="@+id/img_object"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:contentDescription="Đồ vật đếm"
        android:src="@drawable/m4_ic_counting_apple" />

    <!-- Nhãn số thứ tự màu hồng nổi ở góc -->
    <TextView
        android:id="@+id/tv_count_badge"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:background="@drawable/m4_bg_counting_number_badge"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>