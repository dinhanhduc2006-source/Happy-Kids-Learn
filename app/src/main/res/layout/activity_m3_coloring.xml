<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_bg_cream">

    <!-- HEADER -->
    <include layout="@layout/m2_layout_game_header" />

    <!-- BANNER HƯỚNG DẪN -->
    <TextView
        android:id="@+id/tv_m3_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/m3_bg_banner_mint"
        android:padding="16dp"
        android:text="@string/m3_banner_coloring"
        android:textColor="@color/m3_text_main"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- CHỌN TRANH VÀ CHẾ ĐỘ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <!-- Thumbnails -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_thumb_0"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:background="@drawable/m3_bg_item_tile_selected"
                android:src="@drawable/m3_coloring_house" />

            <ImageView
                android:id="@+id/img_thumb_1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:background="@drawable/m3_bg_item_tile"
                android:src="@drawable/m3_coloring_fish" />

            <ImageView
                android:id="@+id/img_thumb_2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:padding="8dp"
                android:background="@drawable/m3_bg_item_tile"
                android:src="@drawable/m3_coloring_flower" />
        </LinearLayout>

        <!-- Switch mode -->
        <Button
            android:id="@+id/btn_m3_switch_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/m3_btn_pill_green"
            android:text="Chế độ: Đổ màu"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- DRAWING AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:background="@drawable/m3_bg_board_white">

        <com.example.happykidlearn.member3.view.FloodFillView
            android:id="@+id/view_m3_flood_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/view_m3_white_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone" />

        <com.example.happykidlearn.member3.view.BaseCanvasView
            android:id="@+id/view_m3_freehand_canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_m3_coloring_outline"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <!-- BẢNG MÀU -->
    <LinearLayout
        android:id="@+id/layout_m3_colors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/m3_bg_board_white"
        android:padding="8dp"
        android:elevation="2dp">

        <View android:id="@+id/color_red" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_red" android:layout_margin="2dp"/>
        <View android:id="@+id/color_orange" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_orange" android:layout_margin="2dp"/>
        <View android:id="@+id/color_yellow" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_yellow" android:layout_margin="2dp"/>
        <View android:id="@+id/color_green" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_green" android:layout_margin="2dp"/>
        <View android:id="@+id/color_blue" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_blue" android:layout_margin="2dp"/>
        <View android:id="@+id/color_purple" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_purple" android:layout_margin="2dp"/>
        <View android:id="@+id/color_pink" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_pink" android:layout_margin="2dp"/>
        <View android:id="@+id/color_brown" android:layout_width="36dp" android:layout_height="36dp" android:background="@color/m3_color_brown" android:layout_margin="2dp"/>
    </LinearLayout>

    <Button android:id="@+id/btn_m3_eraser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/m3_btn_eraser" android:visibility="gone" android:layout_gravity="center" android:layout_marginTop="8dp" android:background="@drawable/m3_bg_item_tile" android:textColor="@color/m3_text_main" />

    <!-- ĐÁY MÀN HÌNH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <Button
            android:id="@+id/btn_m3_clear"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/m3_btn_pill_orange"
            android:text="🔄 Làm mới"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_m3_finish_pic"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/m3_btn_pill_green"
            android:text="✅ Hoàn thành"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>